{
  "name": "tanstack-start-clerk-convex",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "convex dev --once && concurrently -r npm:dev:web npm:dev:convex",
    "dev:web": "vite dev",
    "dev:convex": "convex dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check && eslint convex && node scripts/check-convex-returns.mjs && node scripts/check-hard-rails.mjs",
    "lint:fix": "biome check --write && eslint convex --fix && node scripts/check-convex-returns.mjs && node scripts/check-hard-rails.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "convex:generate": "convex dev --once",
    "convex:check": "pnpm convex:generate && git diff --exit-code HEAD -- convex/_generated ':!convex/_generated/ai'",
    "check:core": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm convex:check",
    "check": "pnpm check:core && pnpm test:e2e",
    "agents:sync": "node scripts/sync-agent-docs.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.4.6",
    "@convex-dev/react-query": "0.1.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "lucide-react": "^1.21.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@clerk/testing": "^2.2.34",
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "~9.2.1",
    "convex-test": "^0.0.58",
    "eslint": "^9.39.4",
    "lefthook": "^2.1.12",
    "nitro": "^3.0.260903-beta",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  }
}
