# Copy to .env.local and fill in. See README.md for the full setup.
# Playwright (`pnpm test:e2e`) loads .env and .env.local too.

# Convex. Written automatically by `npx convex dev` — you normally don't set these by hand.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Clerk API keys (https://dashboard.clerk.com → API keys). Dev instance keys only.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Playwright signed-in specs (optional). An existing Clerk user; use a
# `+clerk_test` address so Clerk sends no emails. Unset → those specs are skipped.
# E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com

# Another project already on :3000? Playwright starts Vite on this port instead.
# E2E_PORT=3123

# NOTE: CLERK_JWT_ISSUER_DOMAIN is NOT set here.
# convex/auth.config.ts reads it from the Convex deployment's environment, so set
# it in the Convex dashboard (Settings → Environment Variables) or with
# `npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev`
# (the Issuer URL of your `convex` JWT template). CI and cloud agents set it on the
# anonymous deployment before the first `convex dev --once`.
